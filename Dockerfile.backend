# REYOG CAPITAL — Backend (FastAPI + real engine)
# Multi-stage build: compile Rust hot-paths, then slim runtime
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# System deps (build-essential for any C wheels; libpq for asyncpg fallback; curl for healthcheck)
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential curl ca-certificates libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Python deps first (cache layer) — G0.2: exact pins, reproducible build.
# Direct runtime set is exact-pinned in requirements.txt (no wildcards, no
# silent `|| true` fallback). Transitive deps resolved by pip, verified by pip check.
COPY requirements.txt ./
RUN pip install --upgrade pip wheel \
    && pip install -r requirements.txt \
    && pip check

# App code
COPY arb/ ./arb/
COPY scripts/ ./scripts/
COPY pyproject.toml ./

# Expose
EXPOSE 8000

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -sf http://localhost:8000/health || exit 1

# Default = API server; engine runs via docker-compose with `command:` override
CMD ["uvicorn", "arb.dashboard.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
