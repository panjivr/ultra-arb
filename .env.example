# ─────────────────────────────────────────────────────────────
# REYOG CAPITAL — Environment template
# Copy to `.env` and customize. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ─── Deployment ───
# Your public-facing domain (no trailing slash)
REYOG_DOMAIN=your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com
NEXT_PUBLIC_WS_URL=wss://your-domain.com

# Backend CORS — comma-separated, or "*" to allow any
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ─── Database (Docker compose internal DSN) ───
DB_USER=arb
DB_PASSWORD=change_this_strong_password_123
DB_NAME=ultra_arb
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://arb:change_this_strong_password_123@postgres:5432/ultra_arb

# ─── Redis ───
# SECURITY: Change this password before deploying to VPS
REDIS_PASSWORD=reyog_redis_secret
REDIS_URL=redis://:reyog_redis_secret@redis:6379/0

# ─── Trading mode ───
# true = paper trading only (safe); false = live execution
PAPER_TRADE=true

# ─── Binance Testnet (https://testnet.binancefuture.com) ───
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# ─── Bybit Testnet (https://testnet.bybit.com) ───
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# ─── Polymarket (Polygon proxy wallet) ───
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_SANDBOX=true

# ─── LIVE autonomous executor (REAL money) — see docs/12-live-otonom.md ───
# ⚠️ NEVER put a real key in THIS file (.env.example is committed to git and is
#    public). Put the values below in `.env` on the SERVER only (.env is
#    gitignored). A private key = full control of that wallet's funds.
#
# The private key + address of a DEDICATED wallet holding only what you can lose.
# POLY_PRIVATE_KEY is what the CLOB adapter signs orders with; the container also
# derives it from POLYMARKET_PRIVATE_KEY, so set both to the same value.
POLY_PRIVATE_KEY=
POLY_WALLET_ADDRESS=
POLY_HOST=https://clob.polymarket.com
POLY_CHAIN_ID=137
# Conservative caps (code enforces hard ceilings on top of these).
LIVE_TOTAL_CAP_USD=25
LIVE_MAX_OPEN=5
LIVE_MIN_GAP_SEC=30
LIVE_MIN_EDGE_BPS=500

# ─── Financial Datasets (https://financialdatasets.ai) ───
# Optional: unlocks 17,000+ equity tickers + earnings + filings
FINANCIAL_DATASETS_API_KEY=

# ─── Risk limits ───
MAX_DRAWDOWN_PCT=2.0
MAX_POSITION_PCT=2.5
MAX_CONCURRENT_POSITIONS=5
VOL_BREAKER_MULTIPLIER=3.0
